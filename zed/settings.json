// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "icon_theme": "Zed (Default)",
  "context_servers": {
    "atlassian-mcp-server": {
      "enabled": true,
      "remote": false,
      "settings": {},
    },
    "chrome-devtools-mcp-zed": {
      "enabled": true,
      "remote": false,
      "settings": {
        "browser_url": null,
        "ws_endpoint": null,
        "ws_headers": null,
        "auto_connect": null,
        "channel": null,
        "headless": null,
        "isolated": null,
        "user_data_dir": null,
        "viewport": null,
        "executable_path": "/bin/thorium-browser",
        "chrome_arg": [],
        "proxy_server": null,
        "accept_insecure_certs": null,
        "category_emulation": null,
        "category_performance": null,
        "category_network": null,
        "log_file": null,
        "extra_args": [],
      },
    },
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "model": "gpt-5.5"
      },
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "ollama",
      "model": "gemma4:26b",
      "enable_thinking": true,
    },
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "auto_discover": true,
    },
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "show_whitespaces": "selection",
  "buffer_line_height": "comfortable",
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
    },
  },
  "ssh_connections": [
    {
      "host": "lagoon",
      "args": [],
      "projects": [
        {
          "paths": ["/home/peppidesu"],
        },
        {
          "paths": ["/home/peppidesu/dev/sandphrog-website"],
        },
        {
          "paths": ["/home/peppidesu/dev/sv-mcrl2/./"],
        },
      ],
    },
  ],
  "languages": {
    "CSharp": {
      "hard_tabs": false,
      "tab_size": 4,
      "language_servers": ["roslyn"],
      // "formatter": "language_server",

      "ensure_final_newline_on_save": false,
    },
    "Rust": {
      "show_edit_predictions": false,
    },
    "Python": {
      "show_edit_predictions": true,
      "language_servers": ["ruff", "pyright"],
    },
    "JavaScript": {
      "formatter": "prettier",
    },
  },
  "show_edit_predictions": false,
  "vim_mode": false,
  "theme": {
    "mode": "system",
    "light": "Everforest Light Hard (material)",
    "dark": "Everforest Dark Hard (material)"
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_family": "Maple Mono NF CN",
  "ui_font_family": "Maple Mono NF CN",
  "terminal": {
    "font_family": "Maple Mono NF CN",
  },
  "git": {
    "git_gutter": "tracked_files",
    "gutter_debounce": 0,
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true,
    },
  },
  "lsp": {
    "roslyn": {
      "binary": {
        "arguments": ["--stdio", "--autoLoadProjects"],
      },
    },
  },
}
